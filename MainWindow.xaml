<Window x:Class="BoramRms.Lite.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="보람 RMS Lite" Icon="Assets/rms-lite-green.ico" Width="1440" Height="940" MinWidth="1060" MinHeight="680"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Background="{StaticResource AppBg}"
 Foreground="{StaticResource TextBrush}" FontFamily="Pretendard, Malgun Gothic, Segoe UI" FontSize="12"
 PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources>
  <DataTemplate x:Key="RowTemplate">
   <Grid MinHeight="30" ToolTip="{Binding RelativePath}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="{Binding QuotaBrush}" CornerRadius="1" Margin="0,5"/>
    <TextBlock Grid.Column="1" Text="{Binding Index}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,6,0">
     <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <Border Grid.Column="3" Background="{Binding StatusBackground}" Padding="5,3" CornerRadius="3" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusForeground}" MaxWidth="92" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/></Border>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ThumbnailTemplate">
   <Grid MinHeight="84" ToolTip="{Binding RelativePath}"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F2F4F3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="3"><Image Source="{Binding Thumbnail}" Width="52" Height="72" Stretch="Uniform"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="AppLayout" Background="{StaticResource AppBg}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="{StaticResource RmsIcon}" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="보람 RMS Lite 녹색 아이콘"/>
     <TextBlock Text="보람 RMS" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
     <Border Background="#FFFFFF" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="LITE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="작업 복원" Click="RestoreSession_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
     <Button Content="되돌리기" Click="Undo_Click" Style="{StaticResource QuietButton}" ToolTip="이번 실행의 마지막 이름·상태·회전을 되돌립니다. 삭제·직접 압축은 제외합니다." Margin="0,0,8,0"/>
     <Button x:Name="UpdateButton" Content="업데이트 확인" Click="Update_Click" Margin="0,0,10,0"/>
     <Button Content="+  폴더 선택" Click="OpenFolder_Click" Style="{StaticResource PrimaryButton}" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="12,8,12,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ListBox x:Name="WorkTabs" SelectionChanged="WorkTabs_SelectionChanged" ItemContainerStyle="{StaticResource WorkTabItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="CloseTab_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" MinHeight="22" Padding="4,0" ToolTip="탭 닫기 · 파일은 유지"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="‹" Click="PreviousTab_Click" ToolTip="이전 작업 탭" Style="{StaticResource QuietButton}"/><Button Content="›" Click="NextTab_Click" ToolTip="다음 작업 탭" Style="{StaticResource QuietButton}"/><Button Content="레이아웃 초기화" Click="ResetLayout_Click" Style="{StaticResource QuietButton}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2" x:Name="WorkArea" Margin="12,0,12,0">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="316" MinWidth="290"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="RightColumn" Width="288" MinWidth="245"/></Grid.ColumnDefinitions>
   <ContentControl x:Name="LeftHost">
    <Border x:Name="LeftPanel" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
     <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,9"><DockPanel><Button DockPanel.Dock="Right" Content="↗" Click="DetachLeft_Click" Style="{StaticResource QuietButton}" ToolTip="리네임 분리"/><TextBlock Text="리네임" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel></Border>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="#F8FAF8" Padding="14,10">
       <StackPanel>
        <Button x:Name="CompressOriginalsButton" Content="300KB 미만으로 줄이기" Click="CompressOriginals_Click" Margin="0,0,0,5"/>
        <TextBlock Text="현재 표시 목록 · 기존 파일에 바로 저장" Style="{StaticResource Hint}" TextAlignment="Center"/>
        <Button x:Name="RecycleSelectedButton" Content="선택 파일 휴지통 이동" Click="Recycle_Click" Style="{StaticResource QuietButton}" Foreground="#AC4942" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="14,12">
        <TextBlock x:Name="CurrentFileText" Text="선택한 이미지가 없습니다" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,10"/>
        <TextBlock Text="구좌수 + 이름" Style="{StaticResource SectionTitle}"/>
        <TextBox x:Name="CombinedTextBox" MinHeight="62" Padding="12,9" VerticalContentAlignment="Center" TextWrapping="NoWrap" FontSize="24" FontWeight="Bold" CharacterCasing="Upper" TextChanged="Rename_TextChanged" BorderBrush="#93B29B" AutomationProperties.Name="구좌수와 이름 입력"/>
        <TextBlock x:Name="NewFileText" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
        <Button x:Name="SaveNextButton" Click="SaveNext_Click" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,0,5"><DockPanel><Border DockPanel.Dock="Right" Background="#20FFFFFF" CornerRadius="3" Padding="5,1" Margin="12,0,0,0"><TextBlock Text="Space" Foreground="White" FontSize="10"/></Border><TextBlock Text="저장하고 다음" Foreground="White"/></DockPanel></Button>
        <UniformGrid Columns="2"><Button Content="저장만" Click="SaveOnly_Click" Margin="0,0,3,0"/><Button Content="건너뛰기" Click="NextImage_Click" Margin="3,0,0,0"/></UniformGrid>
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,15,0,12"/>
        <TextBlock x:Name="SaveHint" Text="이름·상태 수정 후 저장하고 다음" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        <TextBlock Text="보완 사유" Style="{StaticResource SectionTitle}"/>
        <UniformGrid x:Name="RepairReasons" Columns="2" Margin="0,0,0,6">
         <CheckBox Content="화산미기입"/><CheckBox Content="계약일보완"/><CheckBox Content="가입동기보완"/><CheckBox Content="이체희망일보완"/><CheckBox Content="남녀구분미체크"/><CheckBox Content="실명보완"/><CheckBox Content="법인서류보완"/><CheckBox Content="외국인서류보완"/><CheckBox Content="연락처보완"/><CheckBox Content="주소보완"/><CheckBox Content="타인계좌"/><CheckBox Content="계좌보완(CMS)"/>
        </UniformGrid>
        <TextBox x:Name="RepairMemo" ToolTip="추가 보완 메모" AutomationProperties.Name="보완 메모"/>
        <TextBlock Text="기타 상태" Style="{StaticResource SectionTitle}" Margin="0,13,0,6"/>
        <UniformGrid Columns="2"><CheckBox x:Name="CardCheck" Content="카드"/><CheckBox x:Name="WeekendCheck" Content="주말미등록"/><CheckBox x:Name="AdditionalCheck" Content="추가"/><CheckBox x:Name="PreCancelCheck" Content="입력전취소"/><CheckBox x:Name="PostCancelCheck" Content="입력후취소"/><CheckBox x:Name="MistakeCheck" Content="오기입"/><CheckBox x:Name="MinorCheck" Content="미성년자"/><CheckBox x:Name="WrongCheck" Content="오등록"/></UniformGrid>
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="35"/></Grid.RowDefinitions><CheckBox x:Name="PreChangeCheck" Content="입력전변경"/><TextBox Grid.Column="1" x:Name="PreQuota" ToolTip="변경할 구좌수" Margin="0,0,0,3"/><CheckBox Grid.Row="1" x:Name="PostChangeCheck" Content="입력후변경"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PostQuota" ToolTip="변경된 구좌수 · 파일명 유지"/></Grid>
        <TextBox x:Name="StatusMemo" Margin="0,6,0,0" ToolTip="상태 메모" AutomationProperties.Name="상태 메모"/>
        <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="상태 비우기" Click="ClearStatus_Click" Margin="0,0,3,0"/><Button x:Name="SaveStateButton" Content="이름·상태 저장" Click="ApplyStatus_Click" Margin="3,0,0,0" Background="{StaticResource HeaderBg}" Foreground="{StaticResource AccentDark}"/></UniformGrid>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </Border>
   </ContentControl>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
   <ContentControl x:Name="ImageHost" Grid.Column="2">
    <Border x:Name="ImagePanel" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="12,9,12,8">
       <DockPanel><Button DockPanel.Dock="Right" Content="↗" Click="DetachImage_Click" Style="{StaticResource QuietButton}" ToolTip="이미지 분리"/><Border DockPanel.Dock="Left" Background="{StaticResource HeaderBg}" CornerRadius="4" Padding="8,5" Margin="0,0,9,0"><TextBlock x:Name="ImagePositionText" Text="0 / 0" FontWeight="Bold" Foreground="{StaticResource AccentDark}"/></Border><TextBlock x:Name="SelectedFileText" Text="신청서 이미지" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
       <DockPanel Margin="0,7,0,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
         <Button Content="−" Width="30" Padding="0" Click="ZoomOut_Click" Style="{StaticResource QuietButton}"/><TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Content="+" Width="30" Padding="0" Click="ZoomIn_Click" Style="{StaticResource QuietButton}"/>
         <Button Content="맞춤" Click="Fit_Click" Style="{StaticResource QuietButton}" Margin="6,0,2,0"/>
         <Button Content="↶" Click="RotateLeft_Click" Style="{StaticResource QuietButton}" ToolTip="왼쪽 90도 원본 회전"/><Button Content="↷" Click="RotateRight_Click" Style="{StaticResource QuietButton}" ToolTip="오른쪽 90도 원본 회전"/>
        </StackPanel>
        <TextBlock Text="다음 이미지: 보기 유지" ToolTip="창 크기가 바뀌면 전체 이미지에 맞춥니다." Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </DockPanel>
      </StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
       <Button x:Name="PreviousImageRail" Grid.Column="0" Click="PreviousImage_Click" Style="{StaticResource ImageNavButton}" ToolTip="클릭하면 이전 이미지 · 확대와 위치 유지" AutomationProperties.Name="이전 이미지"><Path Data="M12,0 L3,10 L12,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
       <Border Grid.Column="1" x:Name="ImageStage" Background="{StaticResource CanvasBrush}" ClipToBounds="True" Focusable="True" MouseWheel="Image_Wheel" MouseLeftButtonDown="Image_Down" MouseLeftButtonUp="Image_Up" MouseMove="Image_Move" SizeChanged="ImageStage_SizeChanged">
        <Grid ClipToBounds="True">
         <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScale"/><TranslateTransform x:Name="ImageTranslate"/></TransformGroup></Image.RenderTransform></Image>
         <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
          <Border BorderBrush="#B4C7B9" BorderThickness="1.5" CornerRadius="4" Width="44" Height="56" Margin="0,0,0,15" HorizontalAlignment="Center"><StackPanel Margin="9,12"><Border Height="2" Background="#B4C7B9" Margin="0,0,0,6"/><Border Height="2" Background="#B4C7B9" Margin="0,0,0,6"/><Border Height="2" Background="#B4C7B9" Margin="0,0,8,0"/></StackPanel></Border>
          <TextBlock Text="작업할 폴더를 선택하세요" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock Text="이미지 확인과 이름 정리를 한 화면에서" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,7,0,0"/>
          <TextBlock x:Name="ImageError" Foreground="#AC4942" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" Margin="0,10,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
       <Button x:Name="NextImageRail" Grid.Column="2" Click="NextImage_Click" Style="{StaticResource ImageNavButton}" ToolTip="클릭하면 다음 이미지 · 확대와 위치 유지" AutomationProperties.Name="다음 이미지"><Path Data="M3,0 L12,10 L3,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
      </Grid>
      <StackPanel Grid.Row="2" Margin="12,8,12,10"><TextBlock x:Name="ImageDetails" Text="휠 확대 · 드래그 이동 · 좌우 영역 클릭으로 이미지 이동" Style="{StaticResource Hint}"/><TextBlock x:Name="ProgressSummary" Text="선택 위치 0 / 0" Style="{StaticResource Hint}" Margin="0,5,0,0"/><UniformGrid x:Name="QuotaProgress" Columns="6" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </Border>
   </ContentControl>
   <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
   <ContentControl x:Name="RightHost" Grid.Column="4">
    <Border x:Name="RightPanel" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7">
     <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,9"><DockPanel><Button Content="↗" Click="DetachRight_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" ToolTip="목록 분리"/><Button x:Name="ThumbnailsButton" Content="▦" Click="Thumbnails_Click" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" ToolTip="목록/썸네일"/><TextBlock Text="신청서 목록" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel></Border>
      <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
       <TextBlock x:Name="OriginalDirText" Text="선택된 폴더 없음" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,9"/>
       <TextBox x:Name="SearchText" TextChanged="Search_Changed" ToolTip="이름·파일명·메모 검색" AutomationProperties.Name="신청서 검색"/>
       <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" ToolTip="상태 필터"/><ComboBox Grid.Column="2" x:Name="SortMode" SelectionChanged="Filter_Changed" ToolTip="정렬"><ComboBoxItem Content="작업 순서"/><ComboBoxItem Content="구좌 · 이름"/><ComboBoxItem Content="파일명"/></ComboBox><Button Grid.Column="3" Content="↺" Click="ClearFilter_Click" Style="{StaticResource QuietButton}" ToolTip="검색·필터 초기화"/></Grid>
       <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="↻" Click="Refresh_Click" Style="{StaticResource QuietButton}" ToolTip="새로고침 · F5"/><TextBlock x:Name="StatusSummary" Text="전체 0 / 표시 0" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock x:Name="LocalSummary" Text="CMS 0 · 카드 0 · 보완 0" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,9"><StackPanel><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Content="폴더 열기" Click="OpenExplorer_Click" Style="{StaticResource QuietButton}"/><TextBlock Text="Ctrl / Shift 다중 선택" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
      <ListBox x:Name="ImageList" Margin="6,0" SelectionMode="Extended" SelectionChanged="Images_SelectionChanged" ItemTemplate="{StaticResource RowTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
     </DockPanel>
    </Border>
   </ContentControl>
  </Grid>
  <StackPanel Grid.Row="3" Margin="14,8,14,8">
   <DockPanel x:Name="CompressionStatus" Visibility="Collapsed" Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="압축 중단" Click="CancelCompression_Click" Style="{StaticResource SmallButton}"/><ProgressBar x:Name="CompressionProgress" Height="5" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
   <DockPanel><TextBlock DockPanel.Dock="Right" x:Name="VersionText" Text="0.4.0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="StatusText" Text="준비 · 폴더를 선택하세요" FontSize="11" TextWrapping="Wrap" Height="30"/></DockPanel>
   <Expander x:Name="WorkLogExpander" Header="작업 기록" FontSize="10" Margin="0,3,0,0"><TextBox x:Name="LogBox" IsReadOnly="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/></Expander>
  </StackPanel>
 </Grid>
</Window>
