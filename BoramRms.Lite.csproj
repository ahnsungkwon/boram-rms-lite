<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BoramRms.Lite</AssemblyName>
    <RootNamespace>BoramRms.Lite</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationIcon>Assets\rms-lite-green.ico</ApplicationIcon>
    <Description>보람 RMS Lite — 독립 신청서 작업 도구</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;artifacts/**;tests-data/**;.git/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\rms-lite-green.ico" />
    <Compile Remove="MainWindow.Recovery.cs" />
  </ItemGroup>
</Project>
