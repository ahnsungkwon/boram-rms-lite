<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BoramRMS_Lite_Setup</AssemblyName>
    <RootNamespace>BoramRms.Setup</RootNamespace>
    <Version>1.0.2</Version>
    <AppVersion>0.6.2</AppVersion>
    <ApplicationIcon>../Assets/rms-lite-green.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <PackagePath Condition="'$(PackagePath)' == ''">../dist/releases/$(AppVersion)/BoramRMS_Lite_$(AppVersion)_win-x64.zip</PackagePath>
    <MetadataPath Condition="'$(MetadataPath)' == ''">../dist/releases/$(AppVersion)/update-manifest.json</MetadataPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="$(PackagePath)" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(MetadataPath)" LogicalName="payload.json" />
    <EmbeddedResource Include="../Assets/rms-lite-green.ico" LogicalName="brand.ico" />
    <EmbeddedResource Include="FIRST_INSTALL.html" LogicalName="guide.html" />
  </ItemGroup>
</Project>
